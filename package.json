{
  "name": "mlbb-tierlist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "prototype": "node prototype/prototype_direct_fetch.mjs",
    "sync": "node --experimental-strip-types src/pipeline/sync.ts",
    "typecheck": "tsc --noEmit",
    "test:pipeline": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "vitest run",
    "test": "npm run test:pipeline && npm run test:ui",
    "check:bundle": "node scripts/check-bundle-size.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
